FROM bioconductor/bioconductor_docker:RELEASE_3_18

ENV DEBIAN_FRONTEND=noninteractive \
    R_REMOTES_NO_ERRORS_FROM_WARNINGS=true \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SCRNA_JOBS_DIR=/app/jobs \
    SCRNA_CLI_SCRIPT=/app/cli/run_scrna.R \
    SCRNA_MAX_UPLOAD_MB=500 \
    SCRNA_CLI_TIMEOUT_SECONDS=7200 \
    PATH="/opt/venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    zip \
    git \
    curl \
    ca-certificates \
    pandoc \
    cmake \
    gfortran \
    build-essential \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libhdf5-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    libgit2-dev \
    libglpk-dev \
    libbz2-dev \
    liblzma-dev \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Keep Python isolated so pip does not fight Debian/Ubuntu managed packages.
COPY requirements.txt /app/requirements.txt
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && /opt/venv/bin/python -m pip install --no-cache-dir -r /app/requirements.txt \
    && /opt/venv/bin/python -m pip install --no-cache-dir fastapi "uvicorn[standard]" python-multipart pydantic

# Match the working CLI image: install the same R package stack on Bioconductor.
RUN Rscript -e "install.packages(c('optparse','jsonlite','dplyr','tidyr','readr','ggplot2','plotly','htmlwidgets','pROC','caret','randomForest','Matrix','remotes','gprofiler2','enrichR','pwr'), repos='https://cloud.r-project.org')"

RUN Rscript -e "BiocManager::install(c('limma','edgeR'), ask=FALSE, update=FALSE)"

RUN Rscript -e "install.packages('Seurat', repos='https://cloud.r-project.org')"

# Optional speed-up for Seurat differential expression.
RUN Rscript -e "tryCatch(BiocManager::install('presto', ask=FALSE, update=FALSE), error=function(e) message('presto install skipped: ', e$message))"

COPY . /app

RUN mkdir -p /app/jobs \
    && test -f /app/api/main.py \
    && test -f /app/cli/run_scrna.R

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
