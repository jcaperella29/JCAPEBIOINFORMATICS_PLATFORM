#!/usr/bin/env python3
import argparse,json,subprocess,time,urllib.request,shutil,re
from pathlib import Path

def api_path(x):
    p = str(Path(x).resolve())

    # Convert Windows drive paths to WSL paths when necessary.
    m = re.match(r'^([A-Za-z]):[\\/](.*)$', p)
    if m:
        drive = m.group(1).lower()
        rest = m.group(2).replace('\\', '/')
        p = f"/mnt/{drive}/{rest}"

    return p
p=argparse.ArgumentParser();
for k in ['api','counts','meta','condition-col','celltype-col','annotation-col','sample-col','pair-col','de-scope','a','b','target','out']: p.add_argument('--'+k,required=True)
a=p.parse_args(); o=Path(a.out);o.mkdir()
cmd=['curl','--fail-with-body','--silent','--show-error','-X','POST',a.api.rstrip('/')+'/scrna/pseudobulk/local','-F',f'counts_path={api_path(a.counts)}','-F',f'meta_path={api_path(a.meta)}','-F','species=hsapiens','-F','id_type=Symbol','-F',f'condition_col={a.condition_col}','-F',f'celltype_col={a.celltype_col}','-F',f'annotation_col={a.annotation_col}','-F',f'sample_col={a.sample_col}','-F',f'pair_col={a.pair_col}','-F',f'de_scope={a.de_scope}','-F',f'condition_a={a.a}','-F',f'condition_b={a.b}','-F',f'target_celltype={a.target}']
r=subprocess.run(cmd,text=True,capture_output=True); 
if r.returncode: raise SystemExit(r.stdout+'\n'+r.stderr)
j=json.loads(r.stdout); (o/'submission.json').write_text(json.dumps(j,indent=2)); jid=j['job_id']; su=a.api.rstrip('/')+'/'+j.get('status_url',f'/jobs/{jid}').lstrip('/')
for _ in range(2160):
 with urllib.request.urlopen(su,timeout=30) as q: st=json.loads(q.read())
 (o/'status.json').write_text(json.dumps(st,indent=2)); s=str(st.get('status','')).lower()
 if s in {'complete','completed','success','succeeded'}: break
 if s in {'failed','error','deleted'}: raise SystemExit(json.dumps(st,indent=2))
 time.sleep(10)
else: raise SystemExit('scRNA job timeout')
du=a.api.rstrip('/')+'/'+st.get('download_url',j.get('download_url',f'/jobs/{jid}/download')).lstrip('/'); z=o/'scrna_bundle.zip'
subprocess.run(['curl','--fail-with-body','--silent','--show-error','-L',du,'-o',str(z)],check=True); (o/'results').mkdir(); shutil.unpack_archive(z,o/'results')
