#!/usr/bin/env python3
import argparse,json,subprocess,shutil
from pathlib import Path
p=argparse.ArgumentParser();p.add_argument('--api',required=True);p.add_argument('--src',required=True);p.add_argument('--context',required=True);p.add_argument('--mode',required=True);p.add_argument('--out',required=True);a=p.parse_args();o=Path(a.out);o.mkdir();cs=list(Path(a.src).rglob('*.csv'))
f=next((x for x in cs if x.name.lower()=='enrichment_all.csv'),None) or next((x for x in cs if 'enrichment' in x.name.lower() and 'network_edges' not in x.name.lower()),None) or next((x for x in cs if 'network_edges' in x.name.lower()),None)
if not f: raise SystemExit('No enrichment CSV found')
c=json.loads(Path(a.context).read_text()); ph=c.pop('phenotype'); std={k:str(c.pop(k,'')) for k in ['organism','assay','tissue','cell_type','perturbation','timepoint']}; fmt='long_edges' if 'network_edges' in f.name.lower() else 'auto'; z=o/'llm_bundle.zip'
cmd=['curl','--fail-with-body','--silent','--show-error','-X','POST',a.api.rstrip('/')+'/analyze-bundle','-F',f'file=@{f}','-F',f'phenotype={ph}']
for k,v in std.items():cmd+=['-F',f'{k}={v}']
cmd += ['-F',f'extra_context_json={json.dumps(c)}','-F',f'input_format={fmt}','-F',f'mode={a.mode}','-F','make_pdf=true','-o',str(z)]
subprocess.run(cmd,check=True); (o/'results').mkdir(); shutil.unpack_archive(z,o/'results')
