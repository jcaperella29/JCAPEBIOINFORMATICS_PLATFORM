FROM bioconductor/bioconductor_docker:RELEASE_3_18

WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive
ENV R_REMOTES_NO_ERRORS_FROM_WARNINGS=true

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    zip \
    libcurl4-openssl-dev \
    libssl-dev \
    libxml2-dev \
    libhdf5-dev \
    libharfbuzz-dev \
    libfribidi-dev \
    libfontconfig1-dev \
    libfreetype6-dev \
    libpng-dev \
    libtiff5-dev \
    libjpeg-dev \
    && rm -rf /var/lib/apt/lists/*

RUN Rscript -e "install.packages(c('optparse','jsonlite','dplyr','tidyr','readr','ggplot2','plotly','htmlwidgets','pROC','caret','randomForest','Matrix','remotes','gprofiler2','enrichR','pwr'), repos='https://cloud.r-project.org')"

RUN Rscript -e "BiocManager::install(c('limma','edgeR'), ask=FALSE, update=FALSE)"

RUN Rscript -e "install.packages('Seurat', repos='https://cloud.r-project.org')"

# Optional speed-up for Seurat differential expression.
# If this fails on some platform, the CLI should still work without presto.
RUN Rscript -e "tryCatch(BiocManager::install('presto', ask=FALSE, update=FALSE), error=function(e) message('presto install skipped: ', e$message))"

RUN python3 -m pip install --no-cache-dir pandas numpy

# Copy app files when building from the scRNA module directory.
COPY cli /app/cli
COPY tools /app/tools

ENTRYPOINT ["Rscript"]
