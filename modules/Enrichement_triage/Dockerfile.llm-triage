# syntax=docker/dockerfile:1

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PORT=8002 \
    APP_VERSION=0.3.3-fastapi-readable-reports \
    REPORTS_DIR=/work/reports \
    CORS_ALLOW_ORIGINS=*

WORKDIR /work

# Build tools are included because some scientific Python packages may need
# compilation when a prebuilt wheel is unavailable.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gcc \
        g++ \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Copy the complete LLM-triage repository into the image.
# This must include:
# app.py, input_validation.py, program_summarizer.py, summarizer.py,
# triage.py, pipeline.py, reasoner.py, and any other imported modules.
COPY . /work

# Prefer the repository's dependency file when one exists.
# Otherwise install the dependencies visible from app.py plus common
# dependencies used by the PubMed/OpenAI analysis modules.
RUN if [ -f requirements.txt ]; then \
        python -m pip install --upgrade pip setuptools wheel \
        && python -m pip install -r requirements.txt; \
    elif [ -f pyproject.toml ]; then \
        python -m pip install --upgrade pip setuptools wheel \
        && python -m pip install .; \
    else \
        python -m pip install --upgrade pip setuptools wheel \
        && python -m pip install \
            "fastapi>=0.110,<1" \
            "uvicorn[standard]>=0.29,<1" \
            "python-multipart>=0.0.9,<1" \
            "pandas>=2.1,<3" \
            "numpy>=1.26,<3" \
            "python-dotenv>=1,<2" \
            "reportlab>=4,<5" \
            "openai>=1,<3" \
            "biopython>=1.83,<2" \
            "requests>=2.31,<3"; \
    fi

RUN mkdir -p "${REPORTS_DIR}" \
    && useradd --create-home --uid 10001 appuser \
    && chown -R appuser:appuser /work

USER appuser

EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl --fail "http://127.0.0.1:${PORT}/health" || exit 1

CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT}"]
