FROM rnaseq-cli:latest

USER root

RUN pip3 install --no-cache-dir fastapi uvicorn python-multipart pydantic

WORKDIR /work

COPY API/rnaseq_api.py /api/rnaseq_api.py

ENV APP_ROOT=/work
ENV CLI_DIR=/work/CLI
ENV JOB_ROOT=/work/JOBS

ENTRYPOINT []

CMD ["uvicorn", "rnaseq_api:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "/api"]
